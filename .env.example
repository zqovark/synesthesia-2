# Use: node --env-file=.env server/index.mjs
# Never put credentials in browser code, exported scenes or commits.
# Configure only the image providers you want to use:
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (image-capable models only):
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Local image generation with AUTOMATIC1111 / Forge started with --api (recommended, no key):
# A1111_URL=http://127.0.0.1:7860
# A1111_MODEL=your-checkpoint-name
# Optional image dimensions: each defaults to 1024 when omitted.
# Explicit values must be integer multiples of 8 from 256 to 2048 (inclusive).
# For SD 1.5 on a 6 GB GPU, set both to 512.
# A1111_WIDTH=1024
# A1111_HEIGHT=1024
PORT=4310
# Optional local Portuguese voice transcription (see scripts/local_asr.py):
# VOICE_TRANSCRIPTION_URL=http://127.0.0.1:9000/v1/audio/transcriptions
# VOICE_API_KEY=
# VOICE_LANGUAGE=pt-BR
# Alternatively a hosted ASR endpoint (OpenAI-compatible) or Groq:
# GROQ_API_KEY=
# VOICE_TRANSCRIPTION_MODEL=
