# Use: node --env-file=.env server/index.mjs
# Never put credentials in browser code, exported scenes or commits.
NVIDIA_API_KEY=
# Configure only the image providers you want to use:
OPENAI_API_KEY=
GEMINI_API_KEY=
BFL_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
# Optional model overrides (image-capable models only):
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional local AUTOMATIC1111 started with --api:
# A1111_URL=http://127.0.0.1:7860
# A1111_MODEL=your-checkpoint-name
PORT=4310
# Optional voice transcription (Portuguese):
# GROQ_API_KEY=
# Or a compatible ASR endpoint (NVIDIA NIM / Whisper):
# VOICE_TRANSCRIPTION_URL=http://127.0.0.1:9000/v1/audio/transcriptions
# VOICE_TRANSCRIPTION_MODEL=
# VOICE_API_KEY=
# VOICE_LANGUAGE=pt-BR
